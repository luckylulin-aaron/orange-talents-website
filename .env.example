# Copy to .env.local. Keep real values out of source control.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Existing, identity-checked staff accounts only. Comma-separated email addresses.
JOB_EDITOR_EMAILS=
ADMIN_EMAILS=
# SMTP account permitted to send as SMTP_FROM; recipient is fixed in code to hr@orangetalents.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional additional trusted website origins, comma-separated. No wildcards.
ALLOWED_ORIGINS=
