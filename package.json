{
  "name": "spotify-careers-clone",
  "version": "1.0.0",
  "description": "A pixel-perfect clone of Spotify's Life at Spotify recruitment website",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
