    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swiper": "^12.1.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "sass": "^1.69.7",
    "typescript": "^5.3.3",
    "vitest": "^3.2.0"
